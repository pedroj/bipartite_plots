hr.net<- bip_init_network(hr)       # Network object
hr.ig<- bip_init_igraph(hr)         # igraph object
bip_init_igraph <- function (mat) {
igraph::graph_from_biadjacency_matrix(mat,
weighted= T, add.names= NULL)
}
